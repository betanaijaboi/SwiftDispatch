{
  "expo": {
    "name": "SwiftDispatch",
    "slug": "swift-dispatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "swiftdispatch",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.swiftdispatch.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SwiftDispatch uses your location to find nearby riders and track deliveries.",
        "NSLocationAlwaysUsageDescription": "SwiftDispatch uses your location to find nearby riders and track deliveries."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111827"
      },
      "package": "com.swiftdispatch.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SwiftDispatch uses your location to find riders and track deliveries."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111827",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
